    "import numpy as np\n",
    "\n",
    "array = np.array([3, 4, 1, 7, 8, 9])\n",
    "even_array = array[array % 2 == 0]\n",
    "print(even_array) \n",
    "print (\"Original array\")\n",
    "new_array   = array.reshape(2,3)\n",
    "print(new_array)   \n",
    "sum_even = np.sum(array)\n",
    "print(\"Even elements : \",sum_even)\n"
   ]
  }
